ANTHROPIC_API_KEY=your_key_here
# Optional override, defaults to claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Only needed if ANTHROPIC_API_KEY is an org-level key not scoped to a workspace
ANTHROPIC_WORKSPACE_ID=

# Cloudflare Turnstile secret key, from the same site as the public site key
# hardcoded in script.js (TURNSTILE_SITE_KEY) — gates /api/chat against bots
TURNSTILE_SECRET_KEY=
